let currentCat = UI.all;
let showChunks = true;
let showRom = true;
let speeds = [0.8, 0.5, 1.0];
let speedIdx = 0;
let loopingIdx = null;
let mediaRecorder = null;
let audioChunks = [];
let recordedBlobs = {};

function init() {
  document.getElementById("appTitle").textContent = UI.title;
  document.getElementById("chunkBtn").textContent = showChunks ? UI.chunkOn : UI.chunkOff;
  document.getElementById("romBtn").textContent = showRom ? UI.romOn : UI.romOff;
  updateSpeedBtn();

  const cats = [UI.all, CAT.flirt, CAT.food, CAT.hotel, CAT.travel];
  const tabContainer = document.getElementById("categoryTabs");
  tabContainer.innerHTML = cats.map(c => 
    `<button class="tab ${c === currentCat ? 'active' : ''}" onclick="setCat('${c}')">${c}</button>`
  ).join("");
  renderList();
}

function setCat(cat) {
  stopLoop();
  currentCat = cat;
  init();
}

function toggleChunks() {
  showChunks = !showChunks;
  const btn = document.getElementById("chunkBtn");
  btn.textContent = showChunks ? UI.chunkOn : UI.chunkOff;
  btn.classList.toggle("on", showChunks);
  renderList();
}

function toggleRom() {
  showRom = !showRom;
  const btn = document.getElementById("romBtn");
  btn.textContent = showRom ? UI.romOn : UI.romOff;
  btn.classList.toggle("on", showRom);
  renderList();
}

function updateSpeedBtn() {
  const s = speeds[speedIdx];
  const icon = s === 1.0 ? "\uD83D\uDC07" : (s === 0.8 ? "\uD83D\uDC22" : "\uD83D\uDC0C");
  document.getElementById("speedBtn").textContent = `${icon} ${UI.speed}: ${s}x`;
}

function cycleSpeed() {
  speedIdx = (speedIdx + 1) % speeds.length;
  updateSpeedBtn();
}

function formatThai(thStr) {
  if (!showChunks) return thStr.replace(/\s*\|\s*/g, "");
  return thStr.split("|").map(w => `<span class="chunk-word">${w.trim()}</span>`).join("");
}

function renderList() {
  const list = document.getElementById("sentenceList");
  const filtered = currentCat === UI.all ? phrases : phrases.filter(p => p.cat === currentCat);
  list.innerHTML = filtered.map((item, idx) => {
    const rawThai = item.th.replace(/\s*\|\s*/g, "").replace(/\.\.\./g, "");
    const isLooping = loopingIdx === idx;
    return `
      <div class="card ${isLooping ? 'playing' : ''}" id="card-${idx}">
        <div class="cat-badge">${item.cat}</div>
        <div class="thai-text">${formatThai(item.th)}</div>
        ${showRom ? `<div class="rom-text">${item.rom}</div>` : ''}
        <div class="zh-text">${item.zh}</div>
        <div class="breakdown">${UI.notePrefix}${item.note}</div>
        <div class="action-row">
          <button class="btn btn-play" onclick="speakThai('${rawThai}', ${idx}, false)">${UI.play}</button>
          <button class="btn btn-loop ${isLooping ? 'active' : ''}" id="loop-${idx}" onclick="toggleLoop('${rawThai}', ${idx})">
            ${isLooping ? UI.loopStop : UI.loopStart}
          </button>
          <button class="btn btn-rec" id="rec-${idx}" onclick="toggleRecord(${idx})">${UI.recStart}</button>
          <button class="btn btn-loop" id="playrec-${idx}" style="display:${recordedBlobs[idx] ? 'flex':'none'}" onclick="playRecorded(${idx})">${UI.playSelf}</button>
        </div>
      </div>
    `;
  }).join("");
}

function speakThai(text, idx, isLoop) {
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = "th-TH";
  utter.rate = speeds[speedIdx];

  const voices = window.speechSynthesis.getVoices();
  const thaiVoice = voices.find(v => v.lang.includes("th") || v.lang.includes("TH"));
  if (thaiVoice) utter.voice = thaiVoice;

  utter.onend = () => {
    if (loopingIdx === idx) {
      setTimeout(() => {
        if (loopingIdx === idx) speakThai(text, idx, true);
      }, 2200);
    }
  };
  window.speechSynthesis.speak(utter);
}

function toggleLoop(text, idx) {
  if (loopingIdx === idx) {
    stopLoop();
  } else {
    loopingIdx = idx;
    renderList();
    speakThai(text, idx, true);
  }
}

function stopLoop() {
  loopingIdx = null;
  window.speechSynthesis.cancel();
  renderList();
}

async function toggleRecord(idx) {
  const btn = document.getElementById(`rec-${idx}`);
  if (mediaRecorder && mediaRecorder.state === "recording") {
    mediaRecorder.stop();
    btn.classList.remove("recording");
    btn.textContent = UI.recStart;
    return;
  }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    audioChunks = [];
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
    mediaRecorder.onstop = () => {
      recordedBlobs[idx] = new Blob(audioChunks, { type: 'audio/mp4' });
      stream.getTracks().forEach(t => t.stop());
      renderList();
    };
    mediaRecorder.start();
    btn.classList.add("recording");
    btn.textContent = UI.recStop;
  } catch (err) {
    alert(UI.micErr);
  }
}

function playRecorded(idx) {
  if (!recordedBlobs[idx]) return;
  const url = URL.createObjectURL(recordedBlobs[idx]);
  const audio = new Audio(url);
  audio.play();
}

window.speechSynthesis.onvoiceschanged = () => {};
init();
